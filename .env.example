# Copy this file to .env and fill in the values. .env is gitignored; this example is not.
# On Vercel, add the same variables under Project -> Settings -> Environment Variables.

# Postgres connection string, e.g. Neon's pooled URL (host ends in "-pooler").
# Leave it unset locally to use the SQLite file db.sqlite3 instead. Required on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Django signing key: any long random string. Required on Vercel.
DJANGO_SECRET_KEY=change-me

# Optional: extra host names for a custom domain, comma separated (*.vercel.app is already allowed).
# DJANGO_ALLOWED_HOSTS=todo.example.com,www.todo.example.com

# Optional: set to 1 to turn on debug pages on Vercel (off there by default, on locally).
# DJANGO_DEBUG=0

# ---- Morning email (optional) ----
# Any SMTP service. Gmail: smtp.gmail.com, port 587, your address, and an app password
# (Google account -> Security -> App passwords). Resend: smtp.resend.com, user "resend", API key.
# Without EMAIL_HOST, emails are printed in the terminal instead of being sent.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Doneward <you@gmail.com>

# Vercel Cron calls /cron/digest/ once a day with this secret (any long random string).
# CRON_SECRET=change-me-too

# Public address used for links in emails.
# SITE_URL=https://doneward.vercel.app
